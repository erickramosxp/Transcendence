{
  "title": "📱 Rede Social — Métricas",
  "uid": "social-metrics",
  "tags": ["transcendence", "social", "engagement"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "👥 Usuários Online agora",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "social_ws_connections_active", "legendFormat": "Online" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "value": 0, "color": "yellow" }, { "value": 1, "color": "green" }] }
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "id": 2,
      "title": "🤝 Novos usuários na semana",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "increase(social_auth_registrations_total[7d])", "legendFormat": "Registros" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "📝 Posts na semana",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "increase(social_posts_created_total[7d])", "legendFormat": "Posts" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "💬 Mensagens na semana",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "increase(social_messages_sent_total[7d])", "legendFormat": "Mensagens" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "❤️ Likes na semana",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "increase(social_likes_total{action=\"like\"}[7d])", "legendFormat": "Likes" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "🏆 Taxa de Engajamento",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "increase(social_likes_total{action=\"like\"}[7d]) / clamp_min(increase(social_posts_created_total[7d]), 1)", "legendFormat": "Likes/Post" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "yellow" }, { "value": 2, "color": "green" }] } } },
      "options": { "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "👥 Usuários Online ao longo do tempo",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "social_ws_connections_active", "legendFormat": "Online" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "green", "mode": "fixed" } } }
    },
    {
      "id": 8,
      "title": "🔑 Autenticação — Logins e Registros",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_auth_logins_total{result=\"success\"}[1h])", "legendFormat": "Login OK" },
        { "expr": "increase(social_auth_logins_total{result=\"failed\"}[1h])", "legendFormat": "Login Falhou" },
        { "expr": "increase(social_auth_google_logins_total[1h])", "legendFormat": "Google OAuth" },
        { "expr": "increase(social_auth_registrations_total[1h])", "legendFormat": "Registros" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 9,
      "title": "📝 Posts criados por hora",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_posts_created_total[1h])", "legendFormat": "Posts totais" },
        { "expr": "increase(social_posts_with_media_total[1h])", "legendFormat": "Com mídia" },
        { "expr": "increase(social_posts_deleted_total[1h])", "legendFormat": "Deletados" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 10,
      "title": "❤️ Likes por hora",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_likes_total{target=\"post\",action=\"like\"}[1h])", "legendFormat": "Likes em posts" },
        { "expr": "increase(social_likes_total{target=\"comment\",action=\"like\"}[1h])", "legendFormat": "Likes em comentários" },
        { "expr": "increase(social_likes_total{action=\"unlike\"}[1h])", "legendFormat": "Unlikes" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 11,
      "title": "💬 Mensagens por hora",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_messages_sent_total[1h])", "legendFormat": "Total" },
        { "expr": "increase(social_messages_with_media_total[1h])", "legendFormat": "Com mídia" },
        { "expr": "increase(social_messages_with_reply_total[1h])", "legendFormat": "Respostas" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 12,
      "title": "🤝 Amizades por hora",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_friendships_total{action=\"sent\"}[1h])", "legendFormat": "Enviadas" },
        { "expr": "increase(social_friendships_total{action=\"accepted\"}[1h])", "legendFormat": "Aceitas" },
        { "expr": "increase(social_friendships_total{action=\"rejected\"}[1h])", "legendFormat": "Rejeitadas" },
        { "expr": "increase(social_friendships_total{action=\"removed\"}[1h])", "legendFormat": "Desfeitas" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 13,
      "title": "💬 Chats criados por hora",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_chats_created_total{type=\"direct\"}[1h])", "legendFormat": "Chats diretos" },
        { "expr": "increase(social_chats_created_total{type=\"group\"}[1h])", "legendFormat": "Grupos" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 14,
      "title": "🔒 Segurança WebSocket",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_ws_connections_total{event=\"opened\"}[1h])", "legendFormat": "Conexões abertas" },
        { "expr": "increase(social_ws_connections_total{event=\"closed\"}[1h])", "legendFormat": "Conexões fechadas" },
        { "expr": "increase(social_ws_auth_failures_total[1h])", "legendFormat": "Falhas de autenticação" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    }
  ]
}