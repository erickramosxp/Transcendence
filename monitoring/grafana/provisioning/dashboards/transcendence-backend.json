{
  "title": "Transcendence Backend",
  "uid": "transcendence-backend",
  "tags": ["transcendence", "quarkus", "jvm", "social"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "🟢 Backend Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "up{job=\"transcendence-backend\"}", "legendFormat": "Status" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "colorMode": "background"
        }
      }
    },
    {
      "id": 2,
      "title": "👥 Usuários Online (WebSocket)",
      "type": "stat",
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "social_ws_connections_active", "legendFormat": "Online" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] } } }
    },
    {
      "id": 3,
      "title": "💬 Mensagens/min",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "rate(social_messages_sent_total[1m]) * 60", "legendFormat": "msg/min" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "📝 Posts/hora",
      "type": "stat",
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "rate(social_posts_created_total[1h]) * 3600", "legendFormat": "posts/h" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "❤️ Likes/min",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "rate(social_likes_total{action=\"like\"}[1m]) * 60", "legendFormat": "likes/min" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "title": "🤝 Amizades aceitas/hora",
      "type": "stat",
      "gridPos": { "x": 15, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "rate(social_friendships_total{action=\"accepted\"}[1h]) * 3600", "legendFormat": "aceitas/h" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "👥 Usuários Online ao longo do tempo",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "social_ws_connections_active", "legendFormat": "Online" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "green", "mode": "fixed" } } }
    },
    {
      "id": 8,
      "title": "💬 Mensagens enviadas ao longo do tempo",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(social_messages_sent_total[5m]) * 60", "legendFormat": "Total" },
        { "expr": "rate(social_messages_with_media_total[5m]) * 60", "legendFormat": "Com mídia" },
        { "expr": "rate(social_messages_with_reply_total[5m]) * 60", "legendFormat": "Respostas" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 9,
      "title": "🔑 Autenticação",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(social_auth_logins_total{result=\"success\"}[5m]) * 60", "legendFormat": "Login OK" },
        { "expr": "rate(social_auth_logins_total{result=\"failed\"}[5m]) * 60", "legendFormat": "Login Falhou" },
        { "expr": "rate(social_auth_google_logins_total[5m]) * 60", "legendFormat": "Google OAuth" },
        { "expr": "rate(social_auth_registrations_total[5m]) * 60", "legendFormat": "Registros" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10,
      "title": "📝 Engajamento — Posts e Likes",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(social_posts_created_total[5m]) * 300", "legendFormat": "Posts criados" },
        { "expr": "rate(social_posts_with_media_total[5m]) * 300", "legendFormat": "Posts com mídia" },
        { "expr": "rate(social_likes_total{target=\"post\",action=\"like\"}[5m]) * 300", "legendFormat": "Likes em posts" },
        { "expr": "rate(social_likes_total{target=\"comment\",action=\"like\"}[5m]) * 300", "legendFormat": "Likes em comments" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "title": "🤝 Amizades",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(social_friendships_total{action=\"sent\"}[5m]) * 300", "legendFormat": "Enviadas" },
        { "expr": "rate(social_friendships_total{action=\"accepted\"}[5m]) * 300", "legendFormat": "Aceitas" },
        { "expr": "rate(social_friendships_total{action=\"rejected\"}[5m]) * 300", "legendFormat": "Rejeitadas" },
        { "expr": "rate(social_friendships_total{action=\"removed\"}[5m]) * 300", "legendFormat": "Desfeitas" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 12,
      "title": "💬 Chats criados + Falhas WebSocket",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(social_chats_created_total{type=\"direct\"}[5m]) * 300", "legendFormat": "Chats diretos" },
        { "expr": "rate(social_chats_created_total{type=\"group\"}[5m]) * 300", "legendFormat": "Grupos criados" },
        { "expr": "rate(social_ws_auth_failures_total[5m]) * 300", "legendFormat": "Falhas auth WS" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 13,
      "title": "🖥️ JVM — Heap",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\",job=\"transcendence-backend\"}", "legendFormat": "Usado" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\",job=\"transcendence-backend\"}", "legendFormat": "Máximo" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 14,
      "title": "🌐 Requisições HTTP por status",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"transcendence-backend\"}[1m])) by (status)", "legendFormat": "HTTP {{ status }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
