{
  "title": "Transcendence Backend",
  "uid": "transcendence-backend",
  "tags": ["transcendence", "quarkus", "jvm", "social"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "🟢 Backend Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "up{job=\"transcendence-backend\"}", "legendFormat": "Status" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "colorMode": "background"
        }
      }
    },
    {
      "id": 2,
      "title": "👥 Usuários Online agora",
      "type": "stat",
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "social_ws_connections_active", "legendFormat": "Online" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] } } }
    },
    {
      "id": 3,
      "title": "💬 Mensagens na semana",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "increase(social_messages_sent_total[7d])", "legendFormat": "mensagens" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "📝 Posts na semana",
      "type": "stat",
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "increase(social_posts_created_total[7d])", "legendFormat": "posts" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "❤️ Likes na semana",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "increase(social_likes_total{action=\"like\"}[7d])", "legendFormat": "likes" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "title": "🤝 Novos usuários na semana",
      "type": "stat",
      "gridPos": { "x": 15, "y": 0, "w": 3, "h": 4 },
      "targets": [{ "expr": "increase(social_auth_registrations_total[7d])", "legendFormat": "registros" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "👥 Usuários Online ao longo da semana",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "social_ws_connections_active", "legendFormat": "Online" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "green", "mode": "fixed" } } }
    },
    {
      "id": 8,
      "title": "💬 Mensagens por semana",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_messages_sent_total[7d])", "legendFormat": "Total" },
        { "expr": "increase(social_messages_with_media_total[7d])", "legendFormat": "Com mídia" },
        { "expr": "increase(social_messages_with_reply_total[7d])", "legendFormat": "Respostas" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 9,
      "title": "🔑 Autenticação por semana",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_auth_logins_total{result=\"success\"}[7d])", "legendFormat": "Login OK" },
        { "expr": "increase(social_auth_logins_total{result=\"failed\"}[7d])", "legendFormat": "Login Falhou" },
        { "expr": "increase(social_auth_google_logins_total[7d])", "legendFormat": "Google OAuth" },
        { "expr": "increase(social_auth_registrations_total[7d])", "legendFormat": "Registros" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10,
      "title": "📝 Engajamento — Posts e Likes por semana",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_posts_created_total[7d])", "legendFormat": "Posts criados" },
        { "expr": "increase(social_posts_with_media_total[7d])", "legendFormat": "Posts com mídia" },
        { "expr": "increase(social_likes_total{target=\"post\",action=\"like\"}[7d])", "legendFormat": "Likes em posts" },
        { "expr": "increase(social_likes_total{target=\"comment\",action=\"like\"}[7d])", "legendFormat": "Likes em comments" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "title": "🤝 Amizades por semana",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_friendships_total{action=\"sent\"}[7d])", "legendFormat": "Enviadas" },
        { "expr": "increase(social_friendships_total{action=\"accepted\"}[7d])", "legendFormat": "Aceitas" },
        { "expr": "increase(social_friendships_total{action=\"rejected\"}[7d])", "legendFormat": "Rejeitadas" },
        { "expr": "increase(social_friendships_total{action=\"removed\"}[7d])", "legendFormat": "Desfeitas" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 12,
      "title": "💬 Chats criados + Falhas WebSocket por semana",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(social_chats_created_total{type=\"direct\"}[7d])", "legendFormat": "Chats diretos" },
        { "expr": "increase(social_chats_created_total{type=\"group\"}[7d])", "legendFormat": "Grupos criados" },
        { "expr": "increase(social_ws_auth_failures_total[7d])", "legendFormat": "Falhas auth WS" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 13,
      "title": "🖥️ JVM — Heap",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\",job=\"transcendence-backend\"}", "legendFormat": "Usado" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\",job=\"transcendence-backend\"}", "legendFormat": "Máximo" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 14,
      "title": "🌐 Requisições HTTP por status",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"transcendence-backend\"}[1h])) by (status)", "legendFormat": "HTTP {{ status }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}