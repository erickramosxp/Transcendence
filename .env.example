# Banco de Dados (produção: ex. host do pooler Supabase)
DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=
DATABASE_NAME=database name
DATABASE_USER=user database name
DATABASE_PASSWORD=database password

GOOGLE_WEB_CLIENT_ID= client id
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FRONTEND_ORIGIN=
VITE_BACKEND_URL=

# length should be at least 3
MINIO_ROOT_USER=your-user
# length at least 8 characters
MINIO_ROOT_PASSWORD=your-secure-password
MINIO_ENDPOINT=
MINIO_API_ENDPOINT=
MINIO_BUCKET_NAME=

# --- Monitoramento — Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- Monitoramento — Discord ---
# Regenere o webhook em: Discord → Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_NOVO_WEBHOOK_AQUI

# --- Monitoramento — Healthchecks.io ---
# URL de ping do Healthchecks.io usada pelo Alertmanager para sinalizar que o
# Prometheus está vivo. O Alertmanager envia um ping a cada 1 minuto.
# Se o ping parar de chegar (Prometheus ou Alertmanager caíram), o Healthchecks.io
# notifica automaticamente o Discord após o Grace Time (2 minutos).
# Crie o check em https://healthchecks.io com Period=1min e Grace=2min,
# conecte a integração do Discord e cole a URL de ping abaixo.
HEALTHCHECKS_PING_URL=https://hc-ping.com/SEU_UUID_AQUI

# --- Notícias do momento (conta editorial + GNews) ---
# Username da conta que publica manchetes (criada automaticamente pela migration V19)
EDITORIAL_USERNAME=videanews
# Avatar: coloque frontend/public/videanews-avatar.png (URL = FRONTEND_ORIGIN + caminho abaixo)
# EDITORIAL_AVATAR_PATH=/videanews-avatar.png
# Chave em https://gnews.io/ (necessária a partir da Parte 2 — ingestão)
GNEWS_API_KEY=
GNEWS_COUNTRY=br
GNEWS_LANG=pt
GNEWS_MAX_PER_RUN=10

# Frontend — manter igual a EDITORIAL_USERNAME (Vite só expõe variáveis VITE_*)
VITE_EDITORIAL_USERNAME=videanews

# --- Nginx — Monitoramento ---
GRAFANA_SERVER_NAME=grafana.143.198.185.76.nip.io
PROMETHEUS_SERVER_NAME=prometheus.143.198.185.76.nip.io
